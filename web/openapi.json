        "title": "AppInfo",
        "type": "object"
      },
      "Cadence": {
        "additionalProperties": false,
        "description": "How often a producing job runs and when its output counts as stale.",
        "properties": {
          "days": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "daily | trading | weekdays | mon,fri\u2026",
            "title": "Days"
          },
          "every_s": {
            "description": "Nominal seconds between runs",
            "title": "Every S",
            "type": "integer"
          },
          "job": {
            "title": "Job",
            "type": "string"
          },
          "label": {
            "description": "Human cadence, e.g. 'every 30m 09:30-16:00 ET (trading)'",
            "title": "Label",
            "type": "string"
          },
          "stale_after_s": {
            "description": "3 x every_s",
            "title": "Stale After S",
            "type": "integer"
          },
          "window": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Intraday window (ET), if any",
            "title": "Window"
          }
        },
        "required": [
          "job",
          "label",
          "every_s",
          "stale_after_s"
        ],
        "title": "Cadence",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
