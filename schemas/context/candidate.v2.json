{
  "$defs": {
    "CatalystType": {
      "description": "Type of catalyst identified by the Sweep.",
      "enum": [
        "earnings",
        "macro",
        "sector",
        "news",
        "technical"
      ],
      "title": "CatalystType",
      "type": "string"
    },
    "Stance": {
      "description": "Directional stance of a candidate.",
      "enum": [
        "bullish",
        "bearish",
        "neutral"
      ],
      "title": "Stance",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Sweep candidate (E4.2).",
  "properties": {
    "catalyst_date": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Date of the catalyst event",
      "title": "Catalyst Date"
    },
    "catalyst_type": {
      "$ref": "#/$defs/CatalystType"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "corroboration": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Distinct registry sources behind `sources` (D30), computed by the pipeline; repeated items from one source count once. None = not computed (pre-E4.5).",
      "title": "Corroboration"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Audit-store row id once persisted",
      "title": "Id"
    },
    "sources": {
      "items": {
        "type": "string"
      },
      "title": "Sources",
      "type": "array"
    },
    "stance": {
      "$ref": "#/$defs/Stance",
      "description": "Directional stance: bullish | bearish | neutral"
    },
    "ticker": {
      "description": "Underlying symbol, e.g. 'AAPL'",
      "pattern": "^[A-Z][A-Z0-9.]{0,9}$",
      "title": "Ticker",
      "type": "string"
    }
  },
  "required": [
    "ticker",
    "stance",
    "catalyst_type",
    "confidence",
    "created_at"
  ],
  "title": "CandidatePayload",
  "type": "object"
}
