{
  "$defs": {
    "Regime": {
      "description": "Market regime label.",
      "enum": [
        "bear",
        "sideways",
        "bull"
      ],
      "title": "Regime",
      "type": "string"
    },
    "RegimeFeatures": {
      "description": "Markov regime state for one underlying as of one session close.",
      "properties": {
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "current": {
          "$ref": "#/$defs/Regime"
        },
        "expected_duration": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Expected remaining run length of current state in steps; None = absorbing",
          "title": "Expected Duration"
        },
        "fit_window": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "v2: labels used to fit the chains",
          "title": "Fit Window"
        },
        "forecasts": {
          "items": {
            "$ref": "#/$defs/RegimeForecast"
          },
          "title": "Forecasts",
          "type": "array"
        },
        "lookback_days": {
          "title": "Lookback Days",
          "type": "integer"
        },
        "margin_z": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "v2: distance from z to the nearest threshold",
          "title": "Margin Z"
        },
        "model": {
          "default": "v1",
          "description": "Labelling model: v1 = +/-5% trailing return, v2 = vol-scaled z",
          "enum": [
            "v1",
            "v2"
          ],
          "title": "Model",
          "type": "string"
        },
        "n_transitions": {
          "description": "Transitions used to fit the matrix",
          "title": "N Transitions",
          "type": "integer"
        },
        "run_length": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "v2: sessions the current trend label has held",
          "title": "Run Length"
        },
        "rv20": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "v2: annualised 20-session realised vol",
          "title": "Rv20"
        },
        "rv20_pct_rank": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "v2: rv20 percentile in the trailing rank window",
          "title": "Rv20 Pct Rank"
        },
        "stationary": {
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "$ref": "#/$defs/Regime"
          },
          "title": "Stationary",
          "type": "object"
        },
        "step": {
          "description": "Sessions between the two labels of a transition",
          "title": "Step",
          "type": "integer"
        },
        "stickiness": {
          "description": "P[current][current]",
          "title": "Stickiness",
          "type": "number"
        },
        "stickiness_by_state": {
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "$ref": "#/$defs/Regime"
          },
          "title": "Stickiness By State",
          "type": "object"
        },
        "trailing_return": {
          "description": "Trailing lookback return at as_of",
          "title": "Trailing Return",
          "type": "number"
        },
        "transition_matrix": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "number"
            },
            "propertyNames": {
              "$ref": "#/$defs/Regime"
            },
            "type": "object"
          },
          "description": "P[from][to], rows sum to 1",
          "propertyNames": {
            "$ref": "#/$defs/Regime"
          },
          "title": "Transition Matrix",
          "type": "object"
        },
        "trend_z": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "v2: |z| threshold for bull / bear",
          "title": "Trend Z"
        },
        "vol_label_source": {
          "anyOf": [
            {
              "enum": [
                "percentile",
                "fixed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "v2: percentile of own rv20 history, or fixed 12%/20% (warm-up)",
          "title": "Vol Label Source"
        },
        "vol_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/VolState"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "v2: realised-vol state at as_of"
        },
        "vol_stickiness": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "v2: P[vol_state][vol_state]",
          "title": "Vol Stickiness"
        },
        "vol_transition_matrix": {
          "anyOf": [
            {
              "additionalProperties": {
                "additionalProperties": {
                  "type": "number"
                },
                "propertyNames": {
                  "$ref": "#/$defs/VolState"
                },
                "type": "object"
              },
              "propertyNames": {
                "$ref": "#/$defs/VolState"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "v2: vol-state P[from][to], rows sum to 1",
          "title": "Vol Transition Matrix"
        },
        "z": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "v2: r20 / (sigma60 * sqrt(20)) at as_of",
          "title": "Z"
        }
      },
      "required": [
        "as_of",
        "current",
        "trailing_return",
        "lookback_days",
        "step",
        "n_transitions",
        "transition_matrix",
        "stickiness",
        "stickiness_by_state",
        "expected_duration",
        "forecasts",
        "stationary"
      ],
      "title": "RegimeFeatures",
      "type": "object"
    },
    "RegimeForecast": {
      "description": "Regime distribution *horizon* steps ahead.",
      "properties": {
        "horizon": {
          "description": "Steps ahead (1 step = `step` sessions)",
          "minimum": 0,
          "title": "Horizon",
          "type": "integer"
        },
        "probabilities": {
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "$ref": "#/$defs/Regime"
          },
          "title": "Probabilities",
          "type": "object"
        }
      },
      "required": [
        "horizon",
        "probabilities"
      ],
      "title": "RegimeForecast",
      "type": "object"
    },
    "TechnicalFeatures": {
      "additionalProperties": false,
      "description": "Daily technical indicators for one ticker as of one session close.",
      "properties": {
        "as_of": {
          "description": "Session date (ET); bars on or before it only",
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "atr14": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Wilder ATR(14) of the true range",
          "title": "Atr14"
        },
        "atr14_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ATR14 / close",
          "title": "Atr14 Pct"
        },
        "bar_date": {
          "description": "Date of the last bar used (<= as_of)",
          "format": "date",
          "title": "Bar Date",
          "type": "string"
        },
        "bb_width20": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Bollinger(20, 2 sd) width / SMA20",
          "title": "Bb Width20"
        },
        "close": {
          "title": "Close",
          "type": "number"
        },
        "close_vs_prev_range": {
          "anyOf": [
            {
              "enum": [
                "above",
                "inside",
                "below"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Close Vs Prev Range"
        },
        "dist_high20_atr": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "(high20 - close) / ATR14",
          "title": "Dist High20 Atr"
        },
        "dist_low20_atr": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "(close - low20) / ATR14",
          "title": "Dist Low20 Atr"
        },
        "gap_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Today's open / previous close - 1",
          "title": "Gap Pct"
        },
        "high20": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Highest high of the last 20 sessions",
          "title": "High20"
        },
        "implied_move_20d": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "close * iv30 * sqrt(20/252)",
          "title": "Implied Move 20D"
        },
        "implied_vs_atr": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "implied_move_20d / realised_atr_move_20d",
          "title": "Implied Vs Atr"
        },
        "low20": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Lowest low of the last 20 sessions",
          "title": "Low20"
        },
        "missing": {
          "items": {
            "type": "string"
          },
          "title": "Missing",
          "type": "array"
        },
        "pct_from_52w_high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "close / 252-session high - 1",
          "title": "Pct From 52W High"
        },
        "pct_from_52w_low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "close / 252-session low - 1",
          "title": "Pct From 52W Low"
        },
        "pct_vs_sma20": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "close / SMA20 - 1",
          "title": "Pct Vs Sma20"
        },
        "pct_vs_sma200": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pct Vs Sma200"
        },
        "pct_vs_sma50": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pct Vs Sma50"
        },
        "prev_close": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prev Close"
        },
        "prev_high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prev High"
        },
        "prev_low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prev Low"
        },
        "realised_atr_move_20d": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ATR14 * sqrt(20)",
          "title": "Realised Atr Move 20D"
        },
        "ret5d": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "close / close 5 sessions ago - 1",
          "title": "Ret5D"
        },
        "rs_sector_20d": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "20-session return minus the ETF's",
          "title": "Rs Sector 20D"
        },
        "rs_spy_20d": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "20-session return minus SPY's",
          "title": "Rs Spy 20D"
        },
        "rs_spy_60d": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "60-session return minus SPY's",
          "title": "Rs Spy 60D"
        },
        "rsi14": {
          "anyOf": [
            {
              "maximum": 100.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Wilder RSI(14)",
          "title": "Rsi14"
        },
        "sector_etf": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The sector ETF behind rs_sector_20d",
          "title": "Sector Etf"
        },
        "sma20": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sma20"
        },
        "sma200": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sma200"
        },
        "sma50": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sma50"
        },
        "sma50_gt_sma200": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sma50 Gt Sma200"
        },
        "sma50_slope_20d": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SMA50 / SMA50 20 sessions ago - 1",
          "title": "Sma50 Slope 20D"
        },
        "squeeze_days": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Consecutive sessions on; 0 = off",
          "title": "Squeeze Days"
        },
        "squeeze_on": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Bollinger(20, 2 sd) entirely inside Keltner(20, 1.5 ATR20)",
          "title": "Squeeze On"
        },
        "stretch_atr": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "(close - SMA20) / ATR14",
          "title": "Stretch Atr"
        }
      },
      "required": [
        "as_of",
        "bar_date",
        "close"
      ],
      "title": "TechnicalFeatures",
      "type": "object"
    },
    "VolFeatures": {
      "description": "Volatility features for one underlying as of one session close.\n\nFields are ``None`` when the underlying history is too short; the\nreason is recorded in ``missing``.",
      "properties": {
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "hv20": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Annualised 20-session close-to-close HV",
          "title": "Hv20"
        },
        "hv60": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Annualised 60-session close-to-close HV",
          "title": "Hv60"
        },
        "iv": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ATM ~30-DTE implied vol at as_of",
          "title": "Iv"
        },
        "iv_hv20_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Iv Hv20 Ratio"
        },
        "iv_hv60_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Iv Hv60 Ratio"
        },
        "iv_lookback": {
          "default": 252,
          "title": "Iv Lookback",
          "type": "integer"
        },
        "iv_observations": {
          "default": 0,
          "description": "IV observations in the rank/percentile window",
          "title": "Iv Observations",
          "type": "integer"
        },
        "iv_percentile": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Iv Percentile"
        },
        "iv_percentile_ext": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "External IV percentile (only when iv_percentile is None)",
          "title": "Iv Percentile Ext"
        },
        "iv_percentile_ext_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. 'optionstrategist@2026-10-02' (external, approximate)",
          "title": "Iv Percentile Ext Source"
        },
        "iv_rank": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Iv Rank"
        },
        "missing": {
          "items": {
            "type": "string"
          },
          "title": "Missing",
          "type": "array"
        }
      },
      "required": [
        "as_of"
      ],
      "title": "VolFeatures",
      "type": "object"
    },
    "VolState": {
      "description": "Realised-vol state (v2).",
      "enum": [
        "low",
        "mid",
        "high"
      ],
      "title": "VolState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Regime + vol features for one underlying (E4.3).\n\nv4 (E16.2, D76): ``technicals`` (defaulted ``None``), so v3 rows still validate.",
  "properties": {
    "as_of": {
      "description": "Session date (ET); uses data up to that close only",
      "format": "date",
      "title": "As Of",
      "type": "string"
    },
    "last_close": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Close"
    },
    "regime": {
      "anyOf": [
        {
          "$ref": "#/$defs/RegimeFeatures"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "None if history is too short"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "technicals": {
      "anyOf": [
        {
          "$ref": "#/$defs/TechnicalFeatures"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ticker": {
      "description": "Underlying symbol, e.g. 'SPY'",
      "title": "Ticker",
      "type": "string"
    },
    "vol": {
      "$ref": "#/$defs/VolFeatures"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "ticker",
    "as_of",
    "vol"
  ],
  "title": "RegimePayload",
  "type": "object"
}
