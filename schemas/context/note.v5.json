{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "description": "One piece of support for a note.",
      "properties": {
        "quote": {
          "anyOf": [
            {
              "maxLength": 400,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Verbatim excerpt, if textual",
          "title": "Quote"
        },
        "ref": {
          "description": "URL, context entry id, or 'metric:<name>'",
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "ref"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "NoteHorizon": {
      "enum": [
        "intraday",
        "session",
        "swing",
        "macro"
      ],
      "title": "NoteHorizon",
      "type": "string"
    },
    "NoteSection": {
      "additionalProperties": false,
      "description": "One bold-labelled block of a note (E13.13): ``*Thesis:* text`` in Slack.",
      "properties": {
        "label": {
          "enum": [
            "Thesis",
            "Regime",
            "Options sentiment",
            "Evidence",
            "Risks",
            "Themes",
            "Portfolio",
            "Opens",
            "Exits",
            "Execution",
            "Lesson",
            "Summary"
          ],
          "title": "Label",
          "type": "string"
        },
        "text": {
          "maxLength": 1500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "label",
        "text"
      ],
      "title": "NoteSection",
      "type": "object"
    },
    "NoteTopic": {
      "description": "What a :class:`NotePayload` is about (D27).",
      "enum": [
        "thesis",
        "regime_view",
        "portfolio_view",
        "thesis_check",
        "exit_watch",
        "observation",
        "risk_flag",
        "lesson",
        "execution",
        "options_sentiment",
        "theme",
        "discovery"
      ],
      "title": "NoteTopic",
      "type": "string"
    },
    "Stance": {
      "description": "Directional stance of a candidate.",
      "enum": [
        "bullish",
        "bearish",
        "neutral"
      ],
      "title": "Stance",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Free-form but structured persona text (D27): thesis, regime view, observation, ...\n\nNotes are context that other personas may read back. They are never a gate\ninput and never widen :class:`~arc.models.Candidate`.",
  "properties": {
    "about": {
      "description": "Context entry ids this note comments on",
      "items": {
        "type": "string"
      },
      "title": "About",
      "type": "array"
    },
    "body": {
      "anyOf": [
        {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Body"
    },
    "confidence": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 20,
      "title": "Evidence",
      "type": "array"
    },
    "facts": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "integer"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "maxProperties": 20,
      "title": "Facts",
      "type": "object"
    },
    "horizon": {
      "$ref": "#/$defs/NoteHorizon",
      "default": "session"
    },
    "persona": {
      "description": "Author. D54: 'scout' before the rename cutover is the Scalp (legacy rows); after it, the slow-feed Scout persona (E5.13). D56: stored v1 'sweep' / 'director' notes read as 'scalp' / 'research'.",
      "enum": [
        "scalp",
        "scout",
        "research",
        "quant",
        "risk",
        "investor",
        "auditor",
        "broker",
        "ops"
      ],
      "title": "Persona",
      "type": "string"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/NoteSection"
      },
      "maxItems": 8,
      "title": "Sections",
      "type": "array"
    },
    "stance": {
      "anyOf": [
        {
          "$ref": "#/$defs/Stance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "maxItems": 12,
      "title": "Tags",
      "type": "array"
    },
    "title": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "topic": {
      "$ref": "#/$defs/NoteTopic"
    }
  },
  "required": [
    "persona",
    "topic",
    "title"
  ],
  "title": "NotePayload",
  "type": "object"
}
