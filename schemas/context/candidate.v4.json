{
  "$defs": {
    "CatalystType": {
      "description": "Type of catalyst identified by the Scalp.",
      "enum": [
        "earnings",
        "macro",
        "sector",
        "news",
        "technical"
      ],
      "title": "CatalystType",
      "type": "string"
    },
    "Stance": {
      "description": "Directional stance of a candidate.",
      "enum": [
        "bullish",
        "bearish",
        "neutral"
      ],
      "title": "Stance",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Candidate entry (E4.2 Scalp; v3, E13.7: also the Scout; v4, E23.2: pullback watch).\n\nv3 (D53/D56, text-free additions, both defaulted so v2 rows still validate):\n``feed`` names the persona that raised it; ``origins`` are the Scout's YouTube\nchannel ids (``youtube:<slug>``), validated by code against that run's briefs.\nv4 (E23.2, D98): ``origin`` (defaulted ``feed``, so v3 rows still validate) is\n``pullback_watch`` when the Research step re-raised an anti-chase drop whose\nstretch reset (the ticker was not in the day's candidates).",
  "properties": {
    "catalyst_date": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Date of the catalyst event",
      "title": "Catalyst Date"
    },
    "catalyst_type": {
      "$ref": "#/$defs/CatalystType"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "corroboration": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Distinct registry sources behind `sources` (D30), computed by the pipeline; repeated items from one source count once. None = not computed (pre-E4.5).",
      "title": "Corroboration"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "feed": {
      "default": "scalp",
      "enum": [
        "scalp",
        "scout"
      ],
      "title": "Feed",
      "type": "string"
    },
    "id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Audit-store row id once persisted",
      "title": "Id"
    },
    "origin": {
      "default": "feed",
      "enum": [
        "feed",
        "pullback_watch"
      ],
      "title": "Origin",
      "type": "string"
    },
    "origins": {
      "items": {
        "type": "string"
      },
      "maxItems": 6,
      "title": "Origins",
      "type": "array"
    },
    "sources": {
      "items": {
        "type": "string"
      },
      "title": "Sources",
      "type": "array"
    },
    "stance": {
      "$ref": "#/$defs/Stance",
      "description": "Directional stance: bullish | bearish | neutral"
    },
    "ticker": {
      "description": "Underlying symbol, e.g. 'AAPL'",
      "pattern": "^[A-Z][A-Z0-9.]{0,9}$",
      "title": "Ticker",
      "type": "string"
    }
  },
  "required": [
    "ticker",
    "stance",
    "catalyst_type",
    "confidence",
    "created_at"
  ],
  "title": "CandidatePayload",
  "type": "object"
}
