{
  "$defs": {
    "CarryoverKnobs": {
      "additionalProperties": false,
      "description": "D64: the carry-over knobs a merged ``universe_tier`` entry was built with.",
      "properties": {
        "w_prev": {
          "title": "W Prev",
          "type": "number"
        },
        "w_today": {
          "title": "W Today",
          "type": "number"
        },
        "window_h": {
          "title": "Window H",
          "type": "integer"
        }
      },
      "required": [
        "window_h",
        "w_today",
        "w_prev"
      ],
      "title": "CarryoverKnobs",
      "type": "object"
    },
    "Tier": {
      "description": "Universe tiers, highest precedence first (D58: trending is last).",
      "enum": [
        "core",
        "momentum",
        "discovery",
        "trending"
      ],
      "title": "Tier",
      "type": "string"
    },
    "TierMember": {
      "additionalProperties": false,
      "description": "One name in one tier (rank 1 = first).",
      "properties": {
        "also_in": {
          "description": "lower tiers that also listed this name (dedupe)",
          "items": {
            "$ref": "#/$defs/Tier"
          },
          "title": "Also In",
          "type": "array"
        },
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "inputs": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "trending: inputs that listed the name",
          "title": "Inputs"
        },
        "origins": {
          "description": "discovery: the Scout's origins (youtube:<slug>)",
          "items": {
            "type": "string"
          },
          "title": "Origins",
          "type": "array"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "runs": {
          "description": "run dates (ET) that listed the name (1 or 2)",
          "items": {
            "format": "date",
            "type": "string"
          },
          "title": "Runs",
          "type": "array"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "combined score used for ranking (4 dp)",
          "title": "Score"
        },
        "score_prev": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the previous run's own score (None = not in the previous run)",
          "title": "Score Prev"
        },
        "score_today": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "this run's own score (None = not in this run, carried)",
          "title": "Score Today"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "stance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "discovery: the Scout's stance",
          "title": "Stance"
        },
        "ticker": {
          "title": "Ticker",
          "type": "string"
        },
        "tier": {
          "$ref": "#/$defs/Tier"
        }
      },
      "required": [
        "ticker",
        "tier",
        "rank",
        "source",
        "as_of"
      ],
      "title": "TierMember",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``universe_tier`` context entry (subject = tier name).\n\nWriters: the momentum job (E12.2), the Scout (discovery, E13.7) and the\n``universe.trending`` job (D58, E13.19).",
  "properties": {
    "digest": {
      "default": "",
      "title": "Digest",
      "type": "string"
    },
    "fetched_at": {
      "format": "date-time",
      "title": "Fetched At",
      "type": "string"
    },
    "members": {
      "items": {
        "$ref": "#/$defs/TierMember"
      },
      "title": "Members",
      "type": "array"
    },
    "merge": {
      "anyOf": [
        {
          "$ref": "#/$defs/CarryoverKnobs"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "merged_from": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Merged From"
    },
    "partial": {
      "default": false,
      "title": "Partial",
      "type": "boolean"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "source_as_of": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source As Of"
    },
    "tier": {
      "$ref": "#/$defs/Tier"
    },
    "url": {
      "default": "",
      "title": "Url",
      "type": "string"
    }
  },
  "required": [
    "tier",
    "fetched_at",
    "source"
  ],
  "title": "UniverseTierPayload",
  "type": "object"
}
