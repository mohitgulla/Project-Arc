{
  "$defs": {
    "BookLevel": {
      "additionalProperties": false,
      "description": "Top-of-book of one near-ATM contract from the delayed chain.",
      "properties": {
        "ask": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ask"
        },
        "ask_size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ask Size"
        },
        "bid": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Bid"
        },
        "bid_size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Bid Size"
        },
        "expiry": {
          "title": "Expiry",
          "type": "string"
        },
        "iv": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Iv"
        },
        "occ_symbol": {
          "title": "Occ Symbol",
          "type": "string"
        },
        "open_interest": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Open Interest"
        },
        "option_type": {
          "enum": [
            "call",
            "put"
